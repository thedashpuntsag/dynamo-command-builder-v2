{
  "name": "dynamo-command-builder-v2",
  "version": "0.0.0",
  "description": "A dynamo command builder wrapper for AWS DynamoDB SDK v3., written in TypeScript.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "analyze": "du -sh dist && ls -lh dist/",
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "publish:dry": "pnpm pack --dry-run",
    "prepare": "husky"
  },
  "keywords": [
    "dynamodb",
    "aws",
    "wrapper",
    "database",
    "nosql",
    "typescript"
  ],
  "author": "theDashpuntsag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedashpuntsag/dynamo-command-builder-v2.git"
  },
  "bugs": {
    "url": "https://github.com/thedashpuntsag/dynamo-command-builder-v2/issues"
  },
  "homepage": "https://github.com/thedashpuntsag/dynamo-command-builder-v2#readme",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1019.0",
    "@aws-sdk/lib-dynamodb": "^3.1019.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
