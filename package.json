{
  "name": "dynamo-command-builder-v2",
  "version": "0.0.0",
  "description": "A dynamo command builder wrapper for AWS DynamoDB SDK v3., written in TypeScript.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "analyze": "du -sh dist && ls -lh dist/",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "pnpm run build",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "vp test run --passWithNoTests",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage --passWithNoTests",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "publish:dry": "pnpm pack --dry-run",
    "prepare": "husky"
  },
  "keywords": [
    "dynamodb",
    "aws",
    "wrapper",
    "database",
    "nosql",
    "typescript"
  ],
  "author": "theDashpuntsag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedashpuntsag/dynamo-command-builder-v2.git"
  },
  "bugs": {
    "url": "https://github.com/thedashpuntsag/dynamo-command-builder-v2/issues"
  },
  "homepage": "https://github.com/thedashpuntsag/dynamo-command-builder-v2#readme",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0"
    }
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1019.0",
    "@aws-sdk/lib-dynamodb": "^3.1019.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
