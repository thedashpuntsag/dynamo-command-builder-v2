{
  "name": "dynamo-craft",
  "version": "0.1.1",
  "description": "Type-safe command builders for the AWS SDK for JavaScript v3 DynamoDB DocumentClient.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "analyze": "du -sh dist && ls -lh dist/",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "pnpm run build",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "vp test run --passWithNoTests",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage --passWithNoTests",
    "local:dynamo:start": "docker compose up -d dynamodb-local dynamodb-admin",
    "local:dynamo:seed": "vp exec tsx test/local-dynamodb/seed.ts",
    "local:dynamo:clear": "vp exec tsx test/local-dynamodb/clear.ts",
    "local:dynamo:logs": "docker compose logs -f dynamodb-local dynamodb-admin",
    "local:dynamo:stop": "docker compose stop dynamodb-local dynamodb-admin",
    "local:dynamo:down": "docker compose down",
    "playground": "vp dev --config test/playground/vite.config.ts",
    "playground:build": "vp build --config test/playground/vite.config.ts",
    "playground:preview": "vp preview --config test/playground/vite.config.ts",
    "playground:typecheck": "tsc --project test/playground/tsconfig.json --noEmit",
    "playground:smoke": "vp exec tsx test/playground/scripts/smoke.ts",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "check:release": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "publish:dry": "pnpm run check:release && pnpm publish --dry-run --no-git-checks --access public",
    "publish:release": "pnpm whoami && pnpm run check:release && pnpm publish --access public",
    "prepare": "husky"
  },
  "keywords": [
    "dynamodb",
    "aws",
    "wrapper",
    "database",
    "nosql",
    "typescript"
  ],
  "author": "theDashpuntsag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedashpuntsag/dynamo-craft.git"
  },
  "bugs": {
    "url": "https://github.com/thedashpuntsag/dynamo-craft/issues"
  },
  "homepage": "https://github.com/thedashpuntsag/dynamo-craft#readme",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0"
    }
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1019.0",
    "@aws-sdk/lib-dynamodb": "^3.1019.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "codemirror": "^6.0.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "json5": "^2.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
